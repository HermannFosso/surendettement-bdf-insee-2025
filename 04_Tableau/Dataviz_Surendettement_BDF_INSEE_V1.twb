    <dashboard name='Story_01_Surendettement_BDF_INSEE 1' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Surendettement des ménages en France — Comprendre les disparités régionales en 2025</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='994' />
        </style-rule>
      </style>
      <size maxheight='750' maxwidth='1400' minheight='750' minwidth='1400' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97866' id='1' param='vert' removable='false' type-v2='layout-flow' w='98858' x='571' y='1067'>
            <zone h='4133' id='3' type-v2='title' w='98858' x='571' y='1067' />
            <zone fixed-size='128' h='10533' id='4' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98858' x='571' y='5200' />
            <zone h='83200' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98858' x='571' y='15733'>
              <flipboard active-id='5' nav-type='number' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='01 — Des volumes proches, des endettements différents' captured-sheet='Dashboard_01_Story' id='1' />
                  <story-point caption='02 — Dettes à la consommation : fréquence ≠ poids financier.' captured-sheet='Dashboard_02_Story' id='2'>
                    <capturedDeltas>
                      <worksheet name='04_Part_dettes_consommation'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <format attr='title' class='0' field='[federated.0pjg5841risz8x1axdn2p086tm2y].[avg:part_endettement_global_pct:qk]' scope='cols' value='Part des dettes à la consommation (%)' />
                          </style-rule>
                        </style>
                      </worksheet>
                      <worksheet name='05_Part_dossiers_concernes'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <format attr='title' class='0' field='[federated.0pjg5841risz8x1axdn2p086tm2y].[avg:part_dossiers_concernes_pct:qk]' scope='cols' value='Part des dossiers concernés (%)' />
                          </style-rule>
                        </style>
                        <selection-collection>
                          <node-selection select-tuples='false'>
                            <oriented-node-reference orientation='horizontal'>
                              <node-reference>
                                <axis>[federated.0pjg5841risz8x1axdn2p086tm2y].[avg:part_dossiers_concernes_pct:qk]</axis>
